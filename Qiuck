function Quick.createLimboSquares()
    if Quick.limboGui then Quick.limboGui:Destroy() end
    Quick.limboGui = Instance.new("ScreenGui")
    Quick.limboGui.Name = "LimboGame"
    Quick.limboGui.ResetOnSpawn = false
    Quick.limboGui.Parent = player:WaitForChild("PlayerGui")

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 1, 0)
    frame.BackgroundTransparency = 1
    frame.Parent = Quick.limboGui

    Quick.limboSquares = {}

    -- Верхний ряд (4 квадрата)
    for i = 1, 4 do
        local square = Instance.new("TextButton")
        square.Size = UDim2.new(0, 60, 0, 60)
        square.Position = UDim2.new(0, 20 + (i-1)*80, 0, 20)
        square.BackgroundColor3 = Color3.new(0.5, 0.5, 0.5)
        square.Text = ""
        square.Parent = frame
        table.insert(Quick.limboSquares, square)
    end
    -- Нижний ряд (4 квадрата)
    for i = 1, 4 do
        local square = Instance.new("TextButton")
        square.Size = UDim2.new(0, 60, 0, 60)
        square.Position = UDim2.new(0, 20 + (i-1)*80, 1, -80)
        square.BackgroundColor3 = Color3.new(0.5, 0.5, 0.5)
        square.Text = ""
        square.Parent = frame
        table.insert(Quick.limboSquares, square)
    end

    -- Выбираем случайный правильный квадрат
    Quick.limboCorrectSquare = Quick.limboSquares[math.random(1, 8)]

    -- Подсветка зелёным на 2 секунды
    Quick.limboCorrectSquare.BackgroundColor3 = Color3.new(0, 1, 0)
    task.delay(2, function()
        if Quick.limboCorrectSquare then
            Quick.limboCorrectSquare.BackgroundColor3 = Color3.new(0.5, 0.5, 0.5)
        end
    end)

    -- Запускаем движение квадратов
    if Quick.limboMoveConnection then
        Quick.limboMoveConnection:Disconnect()
        Quick.limboMoveConnection = nil
    end
    Quick.limboMoveConnection = runService.Heartbeat:Connect(function(dt)
        for _, sq in ipairs(Quick.limboSquares) do
            local pos = sq.Position
            local newX = pos.X.Offset + math.random(-3, 3)
            local newY = pos.Y.Offset + math.random(-2, 2)
            newX = math.clamp(newX, 10, 380)
            newY = math.clamp(newY, 10, 550)
            sq.Position = UDim2.new(0, newX, 0, newY)
        end
    end)

    -- Обработка кликов
    for _, sq in ipairs(Quick.limboSquares) do
        sq.MouseButton1Click:Connect(function()
            if Quick.limboActive then
                if sq == Quick.limboCorrectSquare then
                    -- Победа
                    local msg = Instance.new("TextLabel")
                    msg.Size = UDim2.new(0, 200, 0, 50)
                    msg.Position = UDim2.new(0.5, -100, 0.5, -25)
                    msg.BackgroundTransparency = 1
                    msg.Text = "You so lucky!"
                    msg.TextColor3 = Color3.new(0, 1, 0)
                    msg.TextScaled = true
                    msg.Font = Enum.Font.GothamBold
                    msg.Parent = Quick.limboGui
                    Quick.limboActive = false
                    Quick.limboBlocked = true
                    Quick.limboStatus.Text = "Завершено"
                    Quick.limboToggle.Visible = false
                    if Quick.limboMoveConnection then
                        Quick.limboMoveConnection:Disconnect()
                        Quick.limboMoveConnection = nil
                    end
                    task.delay(5, function()
                        if Quick.limboGui then Quick.limboGui:Destroy() end
                    end)
                else
                    -- Проигрыш
                    local msg = Instance.new("TextLabel")
                    msg.Size = UDim2.new(0, 200, 0, 50)
                    msg.Position = UDim2.new(0.5, -100, 0.5, -25)
                    msg.BackgroundTransparency = 1
                    msg.Text = "Press F"
                    msg.TextColor3 = Color3.new(1, 0, 0)
                    msg.TextScaled = true
                    msg.Font = Enum.Font.GothamBold
                    msg.Parent = Quick.limboGui
                    Quick.limboActive = false
                    if Quick.limboMoveConnection then
                        Quick.limboMoveConnection:Disconnect()
                        Quick.limboMoveConnection = nil
                    end
                    task.delay(4, function()
                        game:Shutdown()
                    end)
                end
            end
        end)
    end

    Quick.limboActive = true
end

