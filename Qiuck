function Quick.createLabel(parent, text)
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 0, 20)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = Color3.fromRGB(200, 200, 255)
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextScaled = true
    lbl.Font = Enum.Font.SourceSans
    lbl.Parent = parent
    return lbl
end

function Quick.createButton(parent, text, color)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 180, 0, 30)
    btn.BackgroundColor3 = color or Color3.fromRGB(30, 40, 60)
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextScaled = true
    btn.Font = Enum.Font.SourceSansBold
    btn.AutoButtonColor = false
    btn.Parent = parent
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    btn.MouseEnter:Connect(function() btn.BackgroundColor3 = (color or Color3.fromRGB(30,40,60)):Lerp(Color3.new(1,1,1), 0.2) end)
    btn.MouseLeave:Connect(function() btn.BackgroundColor3 = color or Color3.fromRGB(30,40,60) end)
    return btn
end

function Quick.createTextBox(parent, defaultText, width)
    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0, width or 100, 0, 25)
    box.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
    box.Text = defaultText or ""
    box.TextColor3 = Color3.fromRGB(255, 255, 255)
    box.TextScaled = true
    box.Font = Enum.Font.SourceSans
    box.ClearTextOnFocus = false
    box.Parent = parent
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 6)
    return box
end

