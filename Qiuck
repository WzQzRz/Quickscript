local function noclipLoop()
    if not Quick.noclipEnabled or not player.Character then return end
    for _, part in ipairs(player.Character:GetDescendants()) do
        if part:IsA("BasePart") and part ~= player.Character.PrimaryPart then
            part.CanCollide = false
        end
    end
end

