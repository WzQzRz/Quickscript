-- ===       Обновление в RenderStepped    ===
-- ============================================
Quick.lastTime = tick()
Quick.frames = 0
runService.RenderStepped:Connect(function(dt)
    Quick.frames = Quick.frames + 1
    local current = tick()
    if current - Quick.lastTime >= 0.5 then
        Quick.fpsSmall.Text = math.floor(Quick.frames / (current - Quick.lastTime) + 0.5)
        Quick.frames = 0
        Quick.lastTime = current
    end
    for _, ind in ipairs(Quick.indicatorLabels) do
        local state = ind.get()
        ind.label.Text = ind.label.Text:split(":")[1] .. ": " .. (state and "ON" or "OFF")
        ind.label.TextColor3 = state and Quick.indicatorColor or Color3.new(1,0,0)
    end

    -- Обновление Target HUB и круга
    Quick.updateTargetHub()
    if Quick.target then
        if not Quick.targetCircle then Quick.createTargetCircle() end
        Quick.updateTargetCircle()
    else
        if Quick.targetCircle then
            pcall(function() Quick.targetCircle.billboard:Destroy() end)
            Quick.targetCircle = nil
        end
    end

    -- Радужный режим для Jump Particles (если нужен)
    if Quick.rainbowActive then
        Quick.rainbowHue = Quick.rainbowHue + dt * 2
        Quick.jumpParticleColor = Color3.fromHSV(Quick.rainbowHue % 1, 1, 1)
    end
end)

