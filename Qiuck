    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 1, 0)
    frame.BackgroundTransparency = 1
    frame.BorderSizePixel = 0
    frame.Parent = billboard

    local square = Instance.new("ImageLabel")
    square.Size = UDim2.new(1, 0, 1, 0)
    square.BackgroundTransparency = 1
    square.Image = "rbxassetid://6023426926"
    square.ImageColor3 = Quick.targetCircleColor
    square.Parent = frame

    Quick.targetCircle = {billboard = billboard, frame = frame, square = square, rotation = 0}
end

function Quick.updateTargetCircle()
    if not Quick.targetCircle then return end
    Quick.targetCircle.rotation = Quick.targetCircle.rotation + 2
    Quick.targetCircle.square.Rotation = Quick.targetCircle.rotation
    if Quick.target and Quick.target.Character then
        local root = Quick.target.Character:FindFirstChild("HumanoidRootPart")
        if root then
            Quick.targetCircle.billboard.Adornee = root
        else
            Quick.targetCircle.billboard:Destroy()
            Quick.targetCircle = nil
        end
    else
        Quick.targetCircle.billboard:Destroy()
        Quick.targetCircle = nil
    end
end

